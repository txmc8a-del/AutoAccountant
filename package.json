{
  "name": "autoaccountant",
  "version": "2.0.0",
  "description": "Modern realtime accountant and budget manager system with Plaid integration and Google Sheets storage",
  "main": "src/server.js",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/v2/server.js",
    "dev": "nodemon src/v2/server.js",
    "dev:frontend": "next dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "build:frontend": "next build",
    "start:frontend": "next start",
    "test": "jest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "setup": "node scripts/setup.js",
    "test-env": "node test-env.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ananthamapod/AutoAccountant.git"
  },
  "keywords": [
    "accounting",
    "budget",
    "money",
    "plaid",
    "google-sheets",
    "webhooks",
    "nextjs"
  ],
  "author": "Ananth Rao",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/ananthamapod/AutoAccountant/issues"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "googleapis": "^128.0.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "moment": "^2.29.4",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "plaid": "^18.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "winston": "^3.11.0"
  },
    "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "next": "^14.0.4",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.32",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
